---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { img } from '../lib/content';
import Socials from '../components/site/Socials.astro';
import { PREVIEW_HOST } from '../lib/theme';
import versions from '../data/versions.json';
import '../styles/site.css';

// The design one step back (versions.json), opened on the same page by the footer link or the [ key.
const at = versions.versions.findIndex((v) => v.id === versions.current);
const thisVersion = versions.versions[at];
const prevVersion = at > 0 ? versions.versions[at - 1] : undefined;

const SITE_NAME = 'Richthofen';
const DEFAULT_DESCRIPTION =
  'Richthofen works on compute scheduling at Microsoft AI in Seattle, makes theatre and writes essays and reviews in Chinese.';
const DEFAULT_IMAGE = '/img/avatar-nasa.jpg';

type Section = 'writing' | 'theatre' | 'code' | 'about';

export interface Close {
  title: string;
  line?: string;
  href: string;
  label: string;
}

interface Props {
  title: string;
  description?: string;
  lang?: 'en' | 'zh-Hans' | string;
  /** ImageMetadata, a /img/... path or an absolute URL. */
  image?: ImageMetadata | string;
  type?: 'website' | 'article';
  /** Error pages: no canonical/og:url, robots noindex. */
  noindex?: boolean;
  /** The nav word of the section this page belongs to. */
  section?: Section;
  /** The big line and button that open the footer. */
  close?: Close;
  /** Kit UI fragments the page pastes (assets/ui/<name>/fragment.css). */
  fragments?: string[];
  diagrams?: boolean;
  /** Dealt moments the page mounts (assets/moments/<id>). */
  moments?: string[];
}

const {
  title,
  description = DEFAULT_DESCRIPTION,
  lang = 'en',
  image,
  type = 'website',
  noindex = false,
  section,
  close = {
    title: 'Essays and reviews, newest first',
    line: 'The newest, Dine Alone, is about a play where the audience shares bread, and a habit of eating alone that started at school.',
    href: '/writing/',
    label: 'Read the writing',
  },
  fragments = [],
  diagrams = false,
  moments = [],
} = Astro.props;
const fullTitle = title && title !== SITE_NAME ? `${title} · ${SITE_NAME}` : SITE_NAME;
const canonical = noindex ? undefined : new URL(Astro.url.pathname, Astro.site).href;

const source = typeof image === 'string' ? (img(image) ?? image) : image;
let ogImage: string;
if (source && typeof source !== 'string') {
  // Fit inside 1200×1200 without enlarging. Reading source.width directly would make Astro ship
  // the original file as well.
  const out = await getImage({ src: source, width: 1200, height: 1200, fit: 'inside', format: 'jpg' });
  ogImage = new URL(out.src, Astro.site).href;
} else {
  ogImage = new URL(source ?? DEFAULT_IMAGE, Astro.site).href;
}

const menuPhoto = async (path: string) => {
  const meta = img(path);
  if (!meta) throw new Error(`Base: menu photo ${path} not found`);
  const out = await getImage({ src: meta, width: 820, format: 'webp' });
  return { src: out.src, width: out.attributes.width, height: out.attributes.height };
};
const theatreCards = [
  {
    href: '/theatre/#seattle',
    title: 'Seattle, seven productions',
    line: 'With Yun Theatre and Pork Filled Productions',
    ...(await menuPhoto('/img/theatre/productions/2026-home/3.webp')),
    alt: 'Actors reading Home at music stands',
  },
  {
    href: '/theatre/#singapore',
    title: 'Singapore, six productions',
    line: 'With NUS KE VII Chinese Drama',
    ...(await menuPhoto('/img/theatre/productions/2015-the-pillars-of-society/12.webp')),
    alt: 'Four actors in period costume in The Pillars of Society',
  },
  {
    href: '/theatre/#reviews',
    title: 'Reviews',
    line: 'Uncle Vanya, An Enemy of the People, Mary Jane',
    ...(await menuPhoto('/img/theatre/reviews/2024-05-10-uncle-vanya/lincoln-center.webp')),
    alt: 'The neon sign of Lincoln Center Theater over its glass doors',
  },
];

const links: { id: Section; href: string; label: string }[] = [
  { id: 'writing', href: '/writing/', label: 'Writing' },
  { id: 'theatre', href: '/theatre/', label: 'Theatre' },
  { id: 'code', href: '/code/', label: 'Code' },
  { id: 'about', href: '/about/', label: 'About' },
];
const current = (id: Section) => (section === id ? 'page' : undefined);

// One accent per visit, picked before the first paint. Each passes 5.9:1 with white text and
// 5.1:1 on the page ground; cobalt is the dealt default and comes up most often.
const accentScript = `(()=>{try{const a=['#1f2de6','#1f2de6','#c41a2c','#0e6b66','#18703f','#a8460c','#b3175f'];const k='jzp-accent';let c=sessionStorage.getItem(k);if(!a.includes(c)){c=a[Math.floor(Math.random()*a.length)];sessionStorage.setItem(k,c)}const s=document.documentElement.style;s.setProperty('--p-accent',c);s.setProperty('--p-action',c)}catch(e){}})()`;
const fontHref =
  'https://fonts.googleapis.com/css2?family=Instrument+Sans:wdth,wght@75..100,400..700&family=DM+Mono:wght@400;500&display=swap';
const year = new Date().getFullYear();
---

<!doctype html>
<!-- type: software (a compute-infra engineer's site that also holds his theatre and writing)
     deal: hero collage, nav nav-cards, close close-type, footer footer-statement, rhythm dark-band,
     buttons solid, mark wordmark, ground sky, effect silk-folds (hero), moment marquee-row (stage) -->
<html
  lang={lang}
  data-type="software"
  data-radius="soft"
  data-ground="sky"
  data-buttons="solid"
  data-motion
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
    {PREVIEW_HOST && canonical && <meta name="robots" content="noindex" />}
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/feed.xml" />
    <link rel="icon" href="/img/icon/favicon.ico" />
    <meta name="theme-color" content="#eef0f3" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title || SITE_NAME} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang.startsWith('zh') ? 'zh_CN' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title || SITE_NAME} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="site-kind" content="software" />
    <meta name="page-type" content="software" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontHref} rel="stylesheet" />
    <link rel="stylesheet" href="/assets/system.css" />
    <link rel="stylesheet" href="/assets/ui/cards.css" />
    <link rel="stylesheet" href="/assets/motion/motion.css" />
    <link rel="stylesheet" href="/assets/backgrounds/backgrounds.css" />
    <link rel="stylesheet" href="/assets/layout/layout.css" />
    <link rel="stylesheet" href="/assets/icons/icon.css" />
    <style is:inline>
      :root {
        --p-bg: #eef0f3; --p-surface: #e2e5ea; --p-ink: #0b0c0e; --p-muted: #5d6470;
        --p-accent: #1f2de6; --p-accent-ink: #ffffff; --p-action: #1f2de6; --p-action-ink: #ffffff;
        --p-inv-bg: #0b0c0e; --p-inv-surface: #17181a; --p-inv-ink: #eef0f3; --p-inv-muted: #8e8f92;
        --p-inv-accent: #eef0f3; --p-inv-accent-ink: #0b0c0e; --p-inv-action: #eef0f3; --p-inv-action-ink: #0b0c0e;
        --font-display: "Instrument Sans", system-ui, sans-serif;
        --font-text: "Instrument Sans", system-ui, sans-serif;
        --font-mono: "DM Mono", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
        --display-weight: 500;
        --display-tracking: -0.028em;
        --display-tracking-xl: -0.036em;
        --display-stretch: 96%;
        --ly-scale: 1.04;
      }
    </style>
    <script is:inline set:html={accentScript} />
    {fragments.length > 0 && <link rel="stylesheet" href="/assets/ui/base.css" />}
    {fragments.map((f) => <link rel="stylesheet" href={`/assets/ui/${f}/fragment.css`} />)}
    {diagrams && <link rel="stylesheet" href="/assets/diagrams/diagram.css" />}
    <script is:inline>
      document.documentElement.classList.add('m-enter');
      setTimeout(() => document.documentElement.classList.add('m-enter-done'), 700);
    </script>
    <script is:inline src="/assets/backgrounds/backgrounds.js"></script>
    {
      moments.length > 0 && (
        <>
          <script is:inline>
            document.documentElement.classList.add('mo-js');
            setTimeout(() => document.documentElement.classList.add('mo-safe'), 2500);
          </script>
          <link rel="modulepreload" href="/assets/moments/moments.js" />
          <link rel="modulepreload" href="/assets/moments/lib.js" />
          {moments.map((m) => <link rel="modulepreload" href={`/assets/moments/${m}/moment.js`} />)}
        </>
      )
    }
    <slot name="head" />
  </head>
  <body>
    <header class="nav">
      <div class="wrap nav__bar">
        <a class="skip-link" href="#top">Skip to content</a>
        <a class="nav__logo" href="/">Richthofen</a>
        <nav class="nav__links" aria-label="Main">
          {
            links.map((l) =>
              l.id === 'theatre' ? (
                <div class="nav__item">
                  <a class="nav__link" href={l.href} aria-current={current(l.id)}>
                    {l.label}{' '}
                    <svg class="chev" viewBox="0 0 12 12" aria-hidden="true">
                      <path d="M3 4.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </a>
                  <div class="nav__menu">
                    <div class="wrap grid">
                      {theatreCards.map((c) => (
                        <a class="menu-card span-4" href={c.href}>
                          <div class="panel">
                            <img class="frame__img" src={c.src} width={c.width} height={c.height} alt={c.alt} loading="lazy" decoding="async" />
                          </div>
                          <span class="t-card">{c.title}</span>
                          <span class="t-small muted">{c.line}</span>
                        </a>
                      ))}
                    </div>
                  </div>
                </div>
              ) : (
                <div class="nav__item">
                  <a class="nav__link" href={l.href} aria-current={current(l.id)}>
                    {l.label}
                  </a>
                </div>
              ),
            )
          }
        </nav>
        <div class="nav__actions">
          <a class="btn btn--primary" href="/writing/">Read the writing</a>
        </div>
        <button class="nav__toggle" type="button" aria-expanded="false" aria-label="Menu">
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
        </button>
      </div>
    </header>
    <main id="top">
      <slot />
    </main>
    <footer class="footer closing footer--statement" id="contact" aria-labelledby="close-h">
      <div class="wrap">
        <div class="closing__cta close--type">
          <div class="section-head">
            <h2 id="close-h">{close.title}</h2>
            {close.line && <p>{close.line}</p>}
          </div>
          <a class="btn btn--primary btn--xl btn--wide" href={close.href}>
            {close.label}<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"></path><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"></path></svg>
          </a>
        </div>
        <div class="closing__links">
          <div class="grid">
            <div class="span-4 stack-4">
              <a class="nav__logo" href="/">Richthofen</a>
              <p class="footer__lede">Compute infra in Seattle; theatre and essays on the side.</p>
            </div>
            <div class="span-2 footer__col">
              <h3>Writing</h3>
              <ul>
                <li><a href="/writing/#essays">Essays</a></li>
                <li><a href="/writing/#reviews">Reviews</a></li>
                <li><a href="/writing/#movies">Movies</a></li>
              </ul>
            </div>
            <div class="span-2 footer__col">
              <h3>Theatre</h3>
              <ul>
                <li><a href="/theatre/#seattle">Seattle</a></li>
                <li><a href="/theatre/#singapore">Singapore</a></li>
                <li><a href="/theatre/#reviews">Reviews</a></li>
              </ul>
            </div>
            <div class="span-2 footer__col">
              <h3>Code</h3>
              <ul>
                <li><a href="/code/#projects">Projects</a></li>
                <li><a href="/code/#work">Work</a></li>
              </ul>
            </div>
            <div class="span-2 footer__col">
              <h3>About</h3>
              <ul>
                <li><a href="/about/">About me</a></li>
                <li><a href="/feed.xml">RSS feed</a></li>
                <li><a href="/versions/">Site versions</a></li>
              </ul>
            </div>
          </div>
          <div class="footer__legal">
            <span>&copy; {year} Richthofen</span>
            <Socials />
            <span class="credits"
              >Production photographs: NUS KE VII Chinese Drama and Yun Theatre</span
            >
            {
              prevVersion && (
                <p class="footer__versions">
                  <span>Design {thisVersion.id}, since {thisVersion.years.slice(0, 4)}.</span>
                  <a class="link" href={prevVersion.path} data-travel>
                    See this page in the {prevVersion.name.toLowerCase()} design<kbd aria-hidden="true">[</kbd>
                  </a>
                  <a class="link" href="/versions/">Every version</a>
                </p>
              )
            }
          </div>
        </div>
      </div>
    </footer>
    <script is:inline type="module" src="/assets/system.js"></script>
    <script is:inline type="module" src="/assets/motion/motion.js"></script>
    <script is:inline type="module" src="/assets/layout/layout.js"></script>
    {diagrams && <script is:inline type="module" src="/assets/diagrams/mount.js"></script>}
    {
      prevVersion && (
        <script is:inline define:vars={{ prev: prevVersion.path }}>
          // The same page one design back; its home page when that design had no such page.
          const path = location.pathname;
          const there = path.startsWith(prev) ? prev : prev + path.slice(1);
          const travel = () =>
            fetch(there, { method: 'HEAD' }).then(
              (r) => location.assign(r.ok ? there : prev),
              () => location.assign(there),
            );
          for (const a of document.querySelectorAll('a[data-travel]')) {
            a.href = there;
            a.addEventListener('click', (e) => {
              if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button) return;
              e.preventDefault();
              travel();
            });
          }
          addEventListener('keydown', (e) => {
            const t = e.target;
            if (e.key !== '[' || e.metaKey || e.ctrlKey || e.altKey || e.defaultPrevented) return;
            if (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName)) return;
            travel();
          });
        </script>
      )
    }
  </body>
</html>
