---
// The missing page: the title set large, the two ways back and what the site holds.
import Base from '../layouts/Base.astro';
import { getProductions, getWriting } from '../lib/content';
import projects from '../data/projects.json';
import versions from '../data/versions.json';

const productions = await getProductions();
const writing = await getWriting();
// The older designs still served under their own prefix (/v1/); the script below looks for this address there.
const archived = versions.versions.filter((v) => v.path !== '/').map((v) => ({ path: v.path, name: v.name }));
---

<Base title="Page not found" description="This page is not on richthofen.io." noindex moments={['liquid-type']}>
  <section class="hero hero--statement bg-horizon post-hero" data-enter aria-labelledby="hero-h">
    <div class="wrap">
      <div class="hero-text hero__in">
        <div data-moment="liquid-type">
          <h1 id="hero-h" class="mo-lt__type">This page is not here</h1>
          <p class="hero__lead">
            The address may be from the old site, or mistyped. The posts kept their old addresses, so the writing
            and the productions are one click away.
          </p>
          <div class="btn-row">
            <a class="btn btn--primary" href="/"
              >Go to the home page<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"
                ><path class="m-arrow__stem" d="M1 6h8"></path><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"
                ></path></svg
              ></a
            >
            <a class="btn btn--secondary" href="/writing/">Read the writing</a>
          </div>
          <p class="hero__archived" data-archived hidden>
            <a class="link" href="/v1/"><span data-archived-text>Open this address in the classic design</span></a>
          </p>
        </div>
        <dl class="hero__facts">
          <div>
            <dt>Productions</dt>
            <dd>{productions.length} since 2014</dd>
          </div>
          <div>
            <dt>Writing</dt>
            <dd>{writing.length} pieces</dd>
          </div>
          <div>
            <dt>Open tools</dt>
            <dd>{projects.length} on GitHub</dd>
          </div>
          <div>
            <dt>Based in</dt>
            <dd>Seattle</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>
  <script is:inline define:vars={{ archived }}>
    // A page that only an older design has (an old tag page, a retired post) is offered there.
    const path = location.pathname;
    const note = document.querySelector('[data-archived]');
    const inArchive = archived.some((v) => path.startsWith(v.path));
    for (const v of inArchive ? [] : archived) {
      const there = v.path + path.slice(1);
      fetch(there, { method: 'HEAD' }).then((r) => {
        if (!r.ok || !note.hidden) return;
        note.querySelector('a').href = there + location.search + location.hash;
        note.querySelector('[data-archived-text]').textContent = `Open this address in the ${v.name.toLowerCase()} design`;
        note.hidden = false;
      }, () => {});
    }
  </script>
</Base>
