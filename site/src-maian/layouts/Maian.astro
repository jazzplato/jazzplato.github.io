---
// Maian (v3), the page around every page: the head, the nav, the search box, the footer with the other
// designs, and the photo viewer for pages that have photographs. Served at /v3/ in the release (and whole at
// maian.richthofen.io), kept out of search engines: Palette (v2) is the design in use.
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { img } from '../../src/lib/content';
import Prompt from '../components/Prompt.astro';
import versions from '../../src/data/versions.json';
import '../styles/maian.css';

type Section = 'writing' | 'theatre' | 'code' | 'about';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  image?: ImageMetadata | string;
  type?: 'website' | 'article';
  section?: Section;
  /** Mount the photo viewer (pages with a gallery). */
  lightbox?: boolean;
}

const SITE_NAME = 'Richthofen';
const {
  title,
  description = 'Richthofen works on compute scheduling at Microsoft AI in Seattle, makes theatre and writes essays and reviews in Chinese.',
  lang = 'en',
  image,
  type = 'website',
  section,
  lightbox = false,
} = Astro.props;
const fullTitle = title && title !== SITE_NAME ? `${title} · ${SITE_NAME}` : SITE_NAME;
const source = typeof image === 'string' ? (img(image) ?? image) : image;
const ogImage =
  source && typeof source !== 'string'
    ? new URL((await getImage({ src: source, width: 1200, height: 1200, fit: 'inside', format: 'jpg' })).src, Astro.site).href
    : new URL(source ?? '/img/avatar-nasa.jpg', Astro.site).href;

const links: { id: Section; href: string; label: string }[] = [
  { id: 'writing', href: '/writing/', label: 'Writing' },
  { id: 'theatre', href: '/theatre/', label: 'Theatre' },
  { id: 'code', href: '/code/', label: 'Code' },
  { id: 'about', href: '/about/', label: 'About' },
];
const current = (id: Section) => (section === id ? 'page' : undefined);
const fonts =
  'https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,300..600;1,8..60,300..600&family=Source+Sans+3:ital,wght@0,400..600;1,400..600&display=swap';
// The other designs, newest first, [ and ] on the ones a step back and forward: on this origin inside the
// release (base /v3/), on richthofen.io from the preview host (base /).
const origin = import.meta.env.BASE_URL === '/' ? 'https://richthofen.io' : '';
const self = versions.versions.findIndex((v) => v.id === 'v3');
const designs = versions.versions
  .map((v, i) => ({ ...v, key: i === self - 1 ? '[' : i === self + 1 ? ']' : undefined }))
  .filter((v) => v.id !== 'v3')
  .reverse();
const back = versions.versions[self - 1];
const year = new Date().getFullYear();
---

<!doctype html>
<!-- Design v3, Maian: in the manner of microsoft.ai. Its own pages (site/src-maian), the same posts. -->
<html lang={lang} data-design="maian">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/feed.xml" />
    <link rel="icon" href="/img/icon/favicon.ico" />
    <meta name="theme-color" content="#f8f6f1" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title || SITE_NAME} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fonts} rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to the page</a>
    <header class="nav">
      <div class="wrap nav__in">
        <a class="nav__mark" href="/" aria-label="Richthofen, home">Richthofen</a>
        <nav aria-label="Sections">
          <ul class="nav__links">
            {
              links.map((l) => (
                <li>
                  <a href={l.href} aria-current={current(l.id)}>
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="nav__end">
          <button class="pill pill--sm nav__search" type="button" data-open-search aria-label="Search">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"
              ><circle cx="7" cy="7" r="4.5"></circle><path d="m10.5 10.5 3 3" stroke-linecap="round"></path></svg
            >
            <span>Search</span>
            <kbd>/</kbd>
          </button>
          <button class="nav__menu" type="button" data-menu aria-expanded="false" aria-controls="sheet" aria-label="Menu"><span></span></button>
        </div>
      </div>
    </header>
    <nav class="sheet" id="sheet" aria-label="Sections">
      {
        links.map((l) => (
          <a href={l.href} aria-current={current(l.id)}>
            {l.label}
            <svg width="14" height="14" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
              <path d="M4.5 2.5 8 6l-3.5 3.5" />
            </svg>
          </a>
        ))
      }
    </nav>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap">
        <div class="footer__grid">
          <div class="footer__about">
            <a class="footer__mark" href="/">Richthofen</a>
            <p class="footer__blurb">
              Compute scheduling at Microsoft AI by day. Theatre in Seattle, and essays in Chinese, by night.
            </p>
          </div>
          <div>
            <h2>Site</h2>
            <ul>
              {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
            </ul>
          </div>
          <div>
            <h2>Elsewhere</h2>
            <ul>
              <li><a href="https://github.com/jazzplato">GitHub</a></li>
              <li><a href="https://www.linkedin.com/in/liujianqiao">LinkedIn</a></li>
              <li><a href="/feed.xml">RSS</a></li>
            </ul>
          </div>
          <div>
            <h2>Designs</h2>
            <ul>
              {
                designs.map((v) => (
                  <li>
                    <a href={origin + v.path} data-design data-key={v.key}>
                      {v.name}, {v.id}
                    </a>
                  </li>
                ))
              }
              <li><a href={`${origin}/versions/`}>Every version</a></li>
            </ul>
          </div>
        </div>
        <div class="footer__base">
          <span>© {year} Richthofen</span>
          <span>Design v3, Maian · press [ for this page in {back.name}</span>
        </div>
      </div>
    </footer>

    <dialog class="search-dialog" aria-label="Search">
      <Prompt id="search-dialog-q" />
    </dialog>
    {
      lightbox && (
        <dialog class="lightbox" aria-label="Photographs">
          <figure>
            <img alt="" />
          </figure>
          <div class="lightbox__bar">
            <button class="pill pill--ghost pill--sm" type="button" data-prev>
              Previous
            </button>
            <span data-lightbox-count />
            <button class="pill pill--ghost pill--sm" type="button" data-next>
              Next
            </button>
          </div>
          <button class="pill pill--ghost pill--sm lightbox__close" type="button" data-close>
            Close
          </button>
        </dialog>
      )
    }
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
