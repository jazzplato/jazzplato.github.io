---
// Post pages at the Jekyll URLs: /YYYY/MM/DD/slug/
import Maian from '../../../../layouts/Maian.astro';
import Production from '../../../../components/post/Production.astro';
import Writing from '../../../../components/post/Writing.astro';
import { getPosts, renderPost, type Post } from '../../../../../src/lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => {
    const [, year, month, day, slug] = post.url.split('/');
    return { params: { year, month, day, slug }, props: { post } };
  });
}

interface Props {
  post: Post;
}
const { post } = Astro.props;
const production = post.kind === 'production';
const { html } = await renderPost(post, { sizes: production ? '(min-width: 1024px) 50vw, 100vw' : '(min-width: 720px) 660px, 100vw' });
---

<Maian
  title={post.title}
  description={post.excerpt}
  lang={post.lang}
  image={post.cover}
  type="article"
  section={production ? 'theatre' : 'writing'}
  lightbox={production && post.gallery.length > 0}
>
  {production ? <Production post={post} html={html} /> : <Writing post={post} html={html} />}
</Maian>
